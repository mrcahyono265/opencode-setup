{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "plugin": ["opencode-gemini-auth@latest", "@dietrichgebert/ponytail"],

  "provider": {
    "google": {
      "options": {
        "projectId": "durable-surfer-462507-f8",
      },
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",

      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-d4090a00-6dd7-4171-bd5b-114e9320794e",
      },

      "enabled": true,
    },

    "serena": {
      "type": "local",

      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
      ],

      "enabled": true,
    },

    "playwright": {
      "type": "local",

      "command": ["npx", "@playwright/mcp@latest", "--headless"],

      "enabled": true,
    },
    "codebase-memory-mcp": {
      "command": [
        "C:/Users/mrcah/AppData/Local/Programs/codebase-memory-mcp/codebase-memory-mcp.exe",
      ],
      "type": "local",
    },
  },
}
