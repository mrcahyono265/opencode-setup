{
  "$schema": "https://opencode.ai/config.json",

  "lsp": true,

  "plugin": ["opencode-gemini-auth@latest", "@dietrichgebert/ponytail"],

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",

      "headers": {
        "CONTEXT7_API_KEY": "API_HERE",
      },

      "enabled": true,
    },

    "serena": {
      "type": "local",

      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
      ],

      "enabled": true,
    },

    "playwright": {
      "type": "local",

      "command": ["npx", "@playwright/mcp@latest", "--headless"],

      "enabled": true,
    },
    "codebase-memory-mcp": {
      "command": [
        "codebase-memory-mcp.exe_PATH",
      ],
      "type": "local",
    },
  },
}
